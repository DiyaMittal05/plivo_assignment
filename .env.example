# Copy this file to .env and fill in your values. Never commit .env.

# Plivo credentials (Plivo Console -> Overview)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Your Plivo phone number (caller ID), E.164 format e.g. +14155551234
PLIVO_FROM_NUMBER=

# Default number to call (your phone), E.164 format
TARGET_NUMBER=

# Number to forward to for "live associate" (placeholder / your 2nd phone)
ASSOCIATE_NUMBER=


# Public URL of this server (your ngrok https URL, no trailing slash)
BASE_URL=https://xxxx.ngrok-free.app

# Publicly hosted MP3 for the audio message
AUDIO_URL=https://s3.amazonaws.com/plivocloud/Trumpet.mp3

PORT=5050
